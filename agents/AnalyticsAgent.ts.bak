/**
 * AnalyticsAgent — Cruise Math Engineer + NIM-Powered Sentiment Analyst
 * 
 * Deconstructs how CruisePlum normalizes cabin categories, processes
 * taxes/fees, and charts historical price tracking. Designs the unified
 * database schema for our competitor platform. Uses Nvidia NIM (Llama 3.1 70B)
 * for itinerary sentiment analysis, review summarization, and price anomaly detection.
 */

import * as fs from 'fs';
import * as path from 'path';
import { NimClient, createNimClientFromEnv, NimChatMessage } from '../utils/nimClient';
import { defaultRateLimiter as nimRateLimiter } from '../utils/nimRateLimiter';

// ============================================================
// Types
// ============================================================

export interface CruiseLine {
  id: string;
  name: string;
  slug: string;
  logo?: string;
  rating?: number;
  cabins: NormalizedCabinCategory[];
}

export interface NormalizedCabinCategory {
  /** Our normalized tier */
  tier: CabinTier;
  /** Cruise line's original name for this cabin type */
  originalName: string;
  /** Our normalized name */
  normalizedName: string;
  /** Typical amenities included */
  amenities: string[];
  /** Typical square footage range */
  sqftRange: [number, number];
}

export type CabinTier = 'interior' | 'oceanview' | 'balcony' | 'suite' | 'specialty';
export type DealRating = 'hot' | 'great' | 'good' | 'average' | 'poor';

export interface CruisePricing {
  baseFare: number;
  taxesAndFees: number;
  mandatoryGratuities: number;
  totalOutTheDoor: number;
  perPersonPerDay: number;
  currency: string;
  cabinType: CabinTier;
}

export interface PriceHistoryPoint {
  date: string;
  price: number;
  taxesAndFees: number;
  gratuities: number;
  total: number;
  cabinType: CabinTier;
}

export interface CruiseData {
  id: string;
  name: string;
  cruiseLine: string;
  ship: string;
  destination: string;
  duration: number;
  departurePort: string;
  itenerary: string[];
  pricing: CruisePricing[];
  priceHistory: PriceHistoryPoint[];
  dealRating: DealRating;
  soloSupplementPercent: number;
  rating: number;
  reviewCount: number;
}

// ============================================================
// Cabin Normalization Maps
// ============================================================

