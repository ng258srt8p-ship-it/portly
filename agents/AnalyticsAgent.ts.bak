const CABIN_TIER_LABELS: Record<CabinTier, string> = {
  interior: 'Interior',
  oceanview: 'Oceanview',
  balcony: 'Balcony',
  suite: 'Suite',
  specialty: 'Specialty',
};

const CABIN_TIER_ICONS: Record<CabinTier, string> = {
  interior: '🛏️',
  oceanview: '🪟',
  balcony: '🌴',
  suite: '👑',
  specialty: '⭐',
};

// ============================================================
// AnalyticsAgent
// ============================================================

export class AnalyticsAgent {
  private outputDir: string;
  private knownLines: Map<string, CruiseLine> = new Map();
  private nimClient: NimClient | null = null;
  private useNim: boolean = false;
  
  constructor(outputDir: string = './output/analytics', useNim: boolean = false) {
    this.outputDir = outputDir;
    this.useNim = useNim;
    fs.mkdirSync(outputDir, { recursive: true });

    if (useNim) {
      try {
        this.nimClient = createNimClientFromEnv({
          temperature: 0.2,
          model: 'meta/llama-3.1-70b-instruct',
        });
        console.log('[AnalyticsAgent] NIM client initialized for LLM-powered analysis');
      } catch (error) {
        console.warn('[AnalyticsAgent] Failed to initialize NIM client:', error);
        this.useNim = false;
      }
    }
  }

  /**
   * Enable NIM-powered analysis (requires NIM_API_KEY env var)
   */
  enableNim(): void {
    if (!this.nimClient) {
      try {
        this.nimClient = createNimClientFromEnv({
          temperature: 0.2,
          model: 'meta/llama-3.1-70b-instruct',
        });
        this.useNim = true;
        console.log('[AnalyticsAgent] NIM client enabled');
      } catch (error) {
        console.warn('[AnalyticsAgent] Failed to enable NIM:', error);
      }
    } else {
      this.useNim = true;
    }
  }

  /**
   * Disable NIM-powered analysis
   */
  disableNim(): void {
    this.useNim = false;
  }

  /**
   * Check if NIM is enabled
   */
  isNimEnabled(): boolean {
    return this.useNim && this.nimClient !== null;
  }

  /**
   * Get NIM rate limit status
   */
  getNimRateLimitStatus() {
    return this.nimClient?.getRateLimitStatus();
  }

  /**
   * Normalize a cabin type name from any cruise line into our unified schema
   */
  normalizeCabinType(cabinName: string): { tier: CabinTier; normalizedName: string; confidence: number } {
    const lower = cabinName.toLowerCase().trim();
    
    // Direct match
    if (CABIN_NORMALIZATION[lower]) {
      const tier = CABIN_NORMALIZATION[lower];
      return { tier, normalizedName: CABIN_TIER_LABELS[tier], confidence: 1.0 };
    }

    // Partial match scoring
    let bestTier: CabinTier = 'interior';
    let bestScore = 0;

    for (const [key, tier] of Object.entries(CABIN_NORMALIZATION)) {
      if (lower.includes(key)) {
        const score = key.length / lower.length; // How much of the string matches
        if (score > bestScore) {
          bestScore = score;
          bestTier = tier;
        }
      }
    }

    // Keyword-based fallback
    if (bestScore < 0.3) {
      if (lower.includes('suite') || lower.includes('penthouse') || lower.includes('villa') || lower.includes('haven')) {
        bestTier = 'suite';
        bestScore = 0.7;
      } else if (lower.includes('balcony') || lower.includes('veranda') || lower.includes('verandah')) {
        bestTier = 'balcony';
        bestScore = 0.7;
      } else if (lower.includes('ocean') || lower.includes('view') || lower.includes('window') || lower.includes('outside')) {
        bestTier = 'oceanview';
        bestScore = 0.6;
      } else if (lower.includes('inside') || lower.includes('interior') || lower.includes('studio')) {
        bestTier = 'interior';
        bestScore = 0.6;
      } else if (lower.includes('guarantee') || lower.includes('gty') || lower.includes('accessible') || lower.includes('single')) {
        bestTier = 'specialty';
        bestScore = 0.5;
      }
    }

    return {
      tier: bestTier,
      normalizedName: CABIN_TIER_LABELS[bestTier],
      confidence: Math.round(bestScore * 100) / 100,
    };
  }

  /**
   * Calculate out-the-door pricing
   */
  calculateOutTheDoorPricing(params: {
    baseFare: number;
    taxesAndFees: number;
    gratuitiesPerPersonPerNight: number;
    duration: number;
    passengers: number;
    cabinTier: CabinTier;
  }): CruisePricing {
    const totalGratuities = params.gratuitiesPerPersonPerNight * params.duration * params.passengers;
    const total = params.baseFare + params.taxesAndFees + totalGratuities;
    const perPersonPerDay = total / params.passengers / params.duration;

    return {
      baseFare: params.baseFare,
      taxesAndFees: params.taxesAndFees,
      mandatoryGratuities: totalGratuities,
      totalOutTheDoor: total,
      perPersonPerDay: Math.round(perPersonPerDay * 100) / 100,
      currency: 'USD',
      cabinType: params.cabinTier,
    };
  }

  /**
   * Calculate deal rating based on pricing data
   */
  calculateDealRating(cruise: {
    currentPrice: number;
    historicalAveragePrice: number;
    lowestPrice: number;
    priceDrop: number;
    cabinTier: CabinTier;
  }): DealRating {
    const savings = cruise.historicalAveragePrice - cruise.currentPrice;
    const savingsPercent = cruise.historicalAveragePrice > 0 
      ? savings / cruise.historicalAveragePrice 
      : 0;

    if (savingsPercent >= 0.20 || cruise.priceDrop >= 0.20) return 'hot';
    if (savingsPercent >= 0.10 || cruise.priceDrop >= 0.15) return 'great';
    if (savingsPercent >= 0.05 || cruise.priceDrop >= 0.10) return 'good';
    if (cruise.currentPrice <= cruise.historicalAveragePrice) return 'average';
    return 'poor';
  }

  /**
   * Analyze pricing from scraped data and extract components
   */
  analyzePricingFromText(text: string): { baseFare: number | null; taxesAndFees: number | null; gratuities: number | null; total: number | null } {
    const result = { baseFare: null as number | null, taxesAndFees: null as number | null, gratuities: null as number | null, total: null as number | null };
    
    // Look for dollar amounts near price-related keywords
    const lines = text.split('\n');
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i].toLowerCase();
      const prices = line.match(/\$[\d,]+\.?\d*/g);
      if (!prices) continue;

      if (line.includes('base') || line.includes('fare') || line.includes('from')) {
        result.baseFare = parseInt(prices[0].replace(/[$,]/g, ''));
      }
      if (line.includes('tax') || line.includes('fee') || line.includes('port')) {
        result.taxesAndFees = parseInt(prices[0].replace(/[$,]/g, ''));
      }
      if (line.includes('gratuit') || line.includes('tip') || line.includes('service charge')) {
        result.gratuities = parseInt(prices[0].replace(/[$,]/g, ''));
      }
      if (line.includes('total') || line.includes('out the door') || line.includes('all-in')) {
        result.total = parseInt(prices[0].replace(/[$,]/g, ''));
      }
    }

    return result;
  }

  /**
   * Generate the unified database schema for our competitor platform
   */
  generateDatabaseSchema(): string {
    return `-- ============================================================
-- Portly Cruise Platform — Production Database Schema
-- Designed for: Cruise pricing tracking, multi-passenger booking,
--               solo pricing, daily price history, push alerts
-- Engine: PostgreSQL 16 with TimescaleDB extension
-- ============================================================

-- ============================================================
-- ENUMS
-- ============================================================

CREATE TYPE cabin_tier AS ENUM ('interior', 'oceanview', 'balcony', 'suite', 'specialty');
CREATE TYPE deal_rating AS ENUM ('hot', 'great', 'good', 'average', 'poor');
CREATE TYPE alert_type AS ENUM ('price_drop', 'price_rise', 'solo_deal', 'new_deal', 'last_minute');
CREATE TYPE alert_channel AS ENUM ('push', 'email', 'sms', 'webhook');
CREATE TYPE booking_status AS ENUM ('watching', 'price_dropped', 'ready_to_book', 'booked', 'expired');
CREATE TYPE passenger_type AS ENUM ('adult', 'child', 'infant', 'solo');

-- ============================================================
-- CRUISE LINES & SHIPS
-- ============================================================

CREATE TABLE cruise_lines (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name            VARCHAR(100) NOT NULL UNIQUE,
    slug            VARCHAR(120) NOT NULL UNIQUE,
    logo_url        TEXT,
    website         TEXT,
    rating          DECIMAL(2,1) CHECK (rating >= 0 AND rating <= 5),
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE ships (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    cruise_line_id  UUID NOT NULL REFERENCES cruise_lines(id),
    name            VARCHAR(200) NOT NULL,
    year_built      SMALLINT,
    passenger_capacity SMALLINT,
    crew_count      SMALLINT,
    tonnage         INTEGER,
    image_url       TEXT,
    amenities       JSONB DEFAULT '[]',
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    UNIQUE(cruise_line_id, name)
);

-- ============================================================
-- CRUISES (ITINERARIES)
-- ============================================================

CREATE TABLE cruises (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    external_id     VARCHAR(100),              -- CruisePlum/Cruise line reference ID
    name            VARCHAR(300) NOT NULL,
    slug            VARCHAR(320) NOT NULL UNIQUE,
    cruise_line_id  UUID NOT NULL REFERENCES cruise_lines(id),
    ship_id         UUID REFERENCES ships(id),
    destination     VARCHAR(100),
    region          VARCHAR(100),
    duration        SMALLINT NOT NULL CHECK (duration > 0), -- in nights
    departure_port  VARCHAR(100),
    departure_region VARCHAR(100),
    itinerary       JSONB NOT NULL DEFAULT '[]', -- Array of {day, date, port, arrival, departure}
    description     TEXT,
    highlights      TEXT[],
    images          JSONB DEFAULT '[]',
    rating          DECIMAL(2,1) CHECK (rating >= 0 AND rating <= 5),
    review_count    INTEGER DEFAULT 0,
    scraped_from    VARCHAR(500),              -- Source URL
    first_seen_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    last_seen_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    is_active       BOOLEAN NOT NULL DEFAULT true,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- CABIN TYPES (Normalized + Original Mappings)
-- ============================================================

CREATE TABLE cabin_types (
    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    cruise_id           UUID NOT NULL REFERENCES cruises(id) ON DELETE CASCADE,
    tier                cabin_tier NOT NULL,
    normalized_name     VARCHAR(100) NOT NULL,  -- Our name: "Interior", "Oceanview", etc.
    original_name       VARCHAR(200) NOT NULL,  -- Cruise line's name: "Studio Stateroom", "Promenade View", etc.
    description         TEXT,
    max_occupancy       SMALLINT DEFAULT 2,
    has_balcony         BOOLEAN DEFAULT false,
    sqft_min            SMALLINT,
    sqft_max            SMALLINT,
    amenities           JSONB DEFAULT '[]',
    image_url           TEXT,
    created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- PRICING (Current + Historical via TimescaleDB)
-- ============================================================

-- Hyper table for time-series pricing data
CREATE TABLE pricing_history (
    time                TIMESTAMPTZ NOT NULL,
    cruise_id           UUID NOT NULL REFERENCES cruises(id),
    cabin_type_id       UUID NOT NULL REFERENCES cabin_types(id),
    base_fare           DECIMAL(10,2) NOT NULL CHECK (base_fare >= 0),
    taxes_and_fees      DECIMAL(10,2) NOT NULL DEFAULT 0 CHECK (taxes_and_fees >= 0),
    gratuities_per_person DECIMAL(10,2) NOT NULL DEFAULT 0 CHECK (gratuities_per_person >= 0),
    total_per_person    DECIMAL(10,2) NOT NULL CHECK (total_per_person >= 0),
    per_person_per_day  DECIMAL(8,2) CHECK (per_person_per_day >= 0),
    currency            VARCHAR(3) NOT NULL DEFAULT 'USD',
    solo_supplement_pct DECIMAL(5,2) DEFAULT 100, -- 100% = double occupancy price
    is_promo            BOOLEAN DEFAULT false,
    promo_details       TEXT,
    available           BOOLEAN DEFAULT true,
    source              VARCHAR(50),  -- 'scraped', 'manual', 'partner_api'
    created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Convert to hypertable for time-series optimization
-- SELECT create_hypertable('pricing_history', 'time', chunk_time_interval => INTERVAL '7 days');

CREATE TABLE current_pricing (
    cruise_id           UUID NOT NULL REFERENCES cruises(id),
    cabin_type_id       UUID NOT NULL REFERENCES cabin_types(id),
    base_fare           DECIMAL(10,2) NOT NULL,
    taxes_and_fees      DECIMAL(10,2) NOT NULL DEFAULT 0,
    gratuities_per_person DECIMAL(10,2) NOT NULL DEFAULT 0,
    total_per_person    DECIMAL(10,2) NOT NULL,
    per_person_per_day  DECIMAL(8,2),
    currency            VARCHAR(3) NOT NULL DEFAULT 'USD',
    solo_supplement_pct DECIMAL(5,2) DEFAULT 100,
    is_promo            BOOLEAN DEFAULT false,
    promo_details       TEXT,
    available           BOOLEAN DEFAULT true,
    deal_rating         deal_rating,
    price_drop_pct      DECIMAL(5,2),  -- % drop from 7-day average
    lowest_price_30d    DECIMAL(10,2),
    updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    PRIMARY KEY (cruise_id, cabin_type_id),
    FOREIGN KEY (cabin_type_id) REFERENCES cabin_types(id)
);

-- ============================================================
-- PRICE HISTORY AGGREGATES
-- ============================================================

CREATE MATERIALIZED VIEW daily_price_summary AS
SELECT
    time::DATE as date,
    cruise_id,
    cabin_type_id,
    MIN(total_per_person) as lowest_price,
    MAX(total_per_person) as highest_price,
    AVG(total_per_person) as avg_price,
    COUNT(*) as data_points
FROM pricing_history
WHERE time >= NOW() - INTERVAL '90 days'
GROUP BY date, cruise_id, cabin_type_id
ORDER BY date DESC;

-- ============================================================
-- USERS & ACCOUNTS
-- ============================================================

CREATE TABLE users (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email           VARCHAR(255) NOT NULL UNIQUE,
    password_hash   VARCHAR(255) NOT NULL,
    display_name    VARCHAR(100),
    avatar_url      TEXT,
    preferences     JSONB DEFAULT '{}',
    email_verified  BOOLEAN DEFAULT false,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    last_login_at   TIMESTAMPTZ
);

-- ============================================================
-- WATCHLISTS (Saved Cruises)
-- ============================================================

CREATE TYPE booking_status AS ENUM ('watching', 'price_dropped', 'ready_to_book', 'booked', 'expired');

CREATE TABLE watchlist_items (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    cruise_id       UUID NOT NULL REFERENCES cruises(id) ON DELETE CASCADE,
    cabin_type_id   UUID REFERENCES cabin_types(id),
    target_price    DECIMAL(10,2),  -- Alert when price drops below this
    notes           TEXT,
    status          booking_status NOT NULL DEFAULT 'watching',
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    UNIQUE(user_id, cruise_id)
);

-- ============================================================
-- PRICE ALERTS
-- ============================================================

CREATE TABLE price_alerts (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id         UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    cruise_id       UUID NOT NULL REFERENCES cruises(id),
    cabin_type_id   UUID REFERENCES cabin_types(id),
    alert_type      alert_type NOT NULL,
    threshold_price DECIMAL(10,2),  -- Trigger when price crosses this
    threshold_pct   DECIMAL(5,2),   -- Trigger when price changes by this %
    channel         alert_channel NOT NULL DEFAULT 'push',
    destination     VARCHAR(500),   -- email address, phone, webhook URL
    is_active       BOOLEAN NOT NULL DEFAULT true,
    last_triggered_at TIMESTAMPTZ,
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- ============================================================
-- SOLO SUPPLEMENT TRACKING
-- ============================================================

CREATE VIEW solo_friendly_cruises AS
SELECT
    c.id as cruise_id,
    cl.name as cruise_line,
    c.name as cruise_name,
    c.duration,
    c.departure_port,
    ct.tier,
    ct.normalized_name,
    cp.total_per_person,
    cp.solo_supplement_pct,
    CASE
        WHEN cp.solo_supplement_pct <= 0 THEN '🟢 No supplement'
        WHEN cp.solo_supplement_pct <= 25 THEN '🟢 Low supplement'
        WHEN cp.solo_supplement_pct <= 50 THEN '🟡 Moderate supplement'
        WHEN cp.solo_supplement_pct <= 100 THEN '🟠 Standard supplement'
        ELSE '🔴 High supplement'
    END as solo_rating,
    (cp.total_per_person * (1 + cp.solo_supplement_pct / 100)) as solo_total
FROM current_pricing cp
JOIN cruises c ON c.id = cp.cruise_id
JOIN cruise_lines cl ON cl.id = c.cruise_line_id
JOIN cabin_types ct ON ct.id = cp.cabin_type_id
WHERE cp.available = true
AND cp.solo_supplement_pct <= 100
ORDER BY solo_supplement_pct ASC, solo_total ASC;

-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX idx_pricing_cruise_cabin ON pricing_history(cruise_id, cabin_type_id, time DESC);
CREATE INDEX idx_pricing_time ON pricing_history(time DESC);
CREATE INDEX idx_cruises_destination ON cruises(destination);
CREATE INDEX idx_cruises_duration ON cruises(duration);
CREATE INDEX idx_cruises_departure ON cruises(departure_port);
CREATE INDEX idx_cruises_cruise_line ON cruises(cruise_line_id);
CREATE INDEX idx_current_pricing_deal ON current_pricing(deal_rating);
CREATE INDEX idx_current_pricing_total ON current_pricing(total_per_person);
CREATE INDEX idx_current_pricing_solo ON current_pricing(solo_supplement_pct);
CREATE INDEX idx_watchlist_user ON watchlist_items(user_id);
CREATE INDEX idx_alerts_user ON price_alerts(user_id);
CREATE INDEX idx_alerts_active ON price_alerts(is_active) WHERE is_active = true;
CREATE INDEX idx_cabin_types_cruise ON cabin_types(cruise_id);

-- ============================================================
-- TRIGGER: Update updated_at on row changes
-- ============================================================

CREATE OR REPLACE FUNCTION update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_cruises_updated_at BEFORE UPDATE ON cruises
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();
CREATE TRIGGER trg_pricing_updated_at BEFORE UPDATE ON current_pricing
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();
CREATE TRIGGER trg_users_updated_at BEFORE UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();
CREATE TRIGGER trg_watchlist_updated_at BEFORE UPDATE ON watchlist_items
    FOR EACH ROW EXECUTE FUNCTION update_updated_at();
`;
  }

  /**
   * Generate the price alert trigger function (for push notifications)
   */
  generateAlertTriggerFunction(): string {
    return `
-- ============================================================
-- Price Alert Check Function
-- Called by application layer when new pricing is ingested
-- ============================================================

CREATE OR REPLACE FUNCTION check_price_alerts(
    p_cruise_id UUID,
    p_cabin_type_id UUID,
    p_new_total DECIMAL(10,2),
    p_old_total DECIMAL(10,2)
) RETURNS TABLE(
    alert_id UUID,
    user_id UUID,
    alert_type text,
    channel alert_channel,
    destination VARCHAR(500),
    message TEXT
) AS $$
BEGIN
    RETURN QUERY
    SELECT 
        pa.id,
        pa.user_id,
        pa.alert_type::text,
        pa.channel,
        pa.destination,
        CASE 
            WHEN p_new_total < p_old_total AND pa.alert_type = 'price_drop' THEN
                '💲 Price dropped! ' || c.name || ': $' || p_old_total || ' → $' || p_new_total
            WHEN p_new_total > p_old_total AND pa.alert_type = 'price_rise' THEN
                '📈 Price increased! ' || c.name || ': $' || p_old_total || ' → $' || p_new_total
            WHEN p_new_total <= pa.threshold_price THEN
                '🎯 Target price reached! ' || c.name || ' is now $' || p_new_total
            ELSE NULL
        END as message
    FROM price_alerts pa
    JOIN cruises c ON c.id = pa.cruise_id
    WHERE pa.is_active = true
      AND pa.cruise_id = p_cruise_id
      AND (pa.cabin_type_id IS NULL OR pa.cabin_type_id = p_cabin_type_id)
      AND (
          (pa.alert_type = 'price_drop' AND p_new_total < p_old_total) OR
          (pa.alert_type = 'price_rise' AND p_new_total > p_old_total) OR
          (pa.threshold_price IS NOT NULL AND p_new_total <= pa.threshold_price)
      )
      AND (pa.last_triggered_at IS NULL OR pa.last_triggered_at < NOW() - INTERVAL '1 hour');
END;
$$ LANGUAGE plpgsql;
`;
  }

  /**
   * Get cabin tier display info
   */
  getCabinDisplay(tier: CabinTier): { label: string; icon: string; description: string } {
    const map: Record<CabinTier, { label: string; icon: string; description: string }> = {
      interior: { label: 'Interior', icon: '🛏️', description: 'Value-friendly inside cabins without windows' },
      oceanview: { label: 'Oceanview', icon: '🪟', description: 'Cabins with a window or porthole viewing the ocean' },
      balcony: { label: 'Balcony', icon: '🌴', description: 'Private balcony cabins for outdoor access' },
      suite: { label: 'Suite', icon: '👑', description: 'Premium suites with extra space and amenities' },
      specialty: { label: 'Specialty', icon: '⭐', description: 'Guarantee, accessible, connected, and family cabins' },
    };
    return map[tier];
  }

  // ============================================================
  // NIM-Powered Analysis Methods
  // ============================================================

  /**
   * Analyze itinerary sentiment using NIM (Llama 3.1 70B)
   * Evaluates cruise itineraries for appeal, uniqueness, and market positioning
   */
  async analyzeItinerarySentiment(itineraries: Array<{ cruiseName: string; itinerary: string; destination: string; duration: number }>): Promise<Array<{
    cruiseName: string;
    sentimentScore: number; // -1 to 1
    appealRating: 'high' | 'medium' | 'low';
    uniqueSellingPoints: string[];
    targetDemographic: string;
    competitiveAdvantage: string;
    risks: string[];
  }>> {
    if (!this.isNimEnabled() || !this.nimClient) {
      throw new Error('NIM is not enabled. Call enableNim() first.');
    }

    const results = [];
    
    for (const itinerary of itineraries) {
      const prompt = `You are a cruise industry analyst. Analyze this cruise itinerary for market appeal and competitive positioning.

Cruise: ${itinerary.cruiseName}
Destination: ${itinerary.destination}
Duration: ${itinerary.duration} nights
Itinerary: ${itinerary.itinerary}

Provide a JSON response with:
{
  "sentimentScore": number between -1 and 1,
  "appealRating": "high" | "medium" | "low",
  "uniqueSellingPoints": string[],
  "targetDemographic": string,
  "competitiveAdvantage": string,
  "risks": string[]
}

Focus on: destination uniqueness, port variety, shore excursion potential, seasonality, demographic fit, and competitive differentiation.`;

      try {
        const response = await this.nimClient.chatCompletion({
          messages: [
            { role: 'system', content: 'You are an expert cruise industry analyst. Respond only with valid JSON.' },
            { role: 'user', content: prompt }
          ]
        });

        const content = response.choices[0]?.message?.content || '{}';
        const analysis = JSON.parse(content);
        results.push({ cruiseName: itinerary.cruiseName, ...analysis });
        
        // Rate limiting courtesy delay
        await new Promise(resolve => setTimeout(resolve, 100));
      } catch (error) {
        console.error(`[AnalyticsAgent] NIM itinerary analysis failed for ${itinerary.cruiseName}:`, error);
        results.push({
          cruiseName: itinerary.cruiseName,
          sentimentScore: 0,
          appealRating: 'medium',
          uniqueSellingPoints: [],
          targetDemographic: 'Unknown',
          competitiveAdvantage: 'Analysis failed',
          risks: ['Analysis unavailable']
        });
      }
    }

    return results;
  }

  /**
   * Summarize cruise reviews using NIM (Llama 3.1 70B)
   * Extracts key themes, sentiment, and actionable insights from review text
   */
  async summarizeReviews(reviews: Array<{ cruiseName: string; reviewText: string; rating?: number }>): Promise<Array<{
    cruiseName: string;
    summary: string;
    overallSentiment: 'positive' | 'neutral' | 'negative';
    keyThemes: string[];
    pros: string[];
    cons: string[];
    notableQuotes: string[];
    recommendedFor: string[];
    notRecommendedFor: string[];
  }>> {
    if (!this.isNimEnabled() || !this.nimClient) {
      throw new Error('NIM is not enabled. Call enableNim() first.');
    }

    const results = [];
    
    for (const review of reviews) {
      const prompt = `You are a cruise review analyst. Summarize this cruise review into structured insights.

Cruise: ${review.cruiseName}
Rating: ${review.rating || 'Not provided'}/5
Review: ${review.reviewText}

Provide a JSON response with:
{
  "summary": "2-3 sentence executive summary",
  "overallSentiment": "positive" | "neutral" | "negative",
  "keyThemes": string[],
  "pros": string[],
  "cons": string[],
  "notableQuotes": string[],
  "recommendedFor": string[],
  "notRecommendedFor": string[]
}

Focus on: cabin quality, service, food, entertainment, value, embarkation, ports, demographics.`;

      try {
        const response = await this.nimClient.chatCompletion({
          messages: [
            { role: 'system', content: 'You are an expert cruise review analyst. Respond only with valid JSON.' },
            { role: 'user', content: prompt }
          ]
        });

        const content = response.choices[0]?.message?.content || '{}';
        const analysis = JSON.parse(content);
        results.push({ cruiseName: review.cruiseName, ...analysis });
        
        await new Promise(resolve => setTimeout(resolve, 100));
      } catch (error) {
        console.error(`[AnalyticsAgent] NIM review summary failed for ${review.cruiseName}:`, error);
        results.push({
          cruiseName: review.cruiseName,
          summary: 'Analysis failed',
          overallSentiment: 'neutral',
          keyThemes: [],
          pros: [],
          cons: [],
          notableQuotes: [],
          recommendedFor: [],
          notRecommendedFor: []
        });
      }
    }

    return results;
  }

  /**
   * Detect pricing anomalies using NIM (Llama 3.1 70B)
   * Identifies unusual pricing patterns, potential errors, or strategic pricing moves
   */
  async detectPriceAnomalies(pricingData: Array<{
    cruiseName: string;
    cruiseLine: string;
    cabinTier: string;
    currentPrice: number;
    historicalAverage: number;
    priceHistory: number[];
    daysUntilDeparture: number;
  }>): Promise<Array<{
    cruiseName: string;
    anomalyType: 'price_drop' | 'price_spike' | 'unusual_pattern' | 'potential_error' | 'strategic_pricing';
    severity: 'low' | 'medium' | 'high' | 'critical';
    confidence: number; // 0-1
    description: string;
    recommendation: string;
    expectedPriceRange: { min: number; max: number };
  }>> {
    if (!this.isNimEnabled() || !this.nimClient) {
      throw new Error('NIM is not enabled. Call enableNim() first.');
    }

    const results = [];
    
    for (const pricing of pricingData) {
      const priceDrop = pricing.historicalAverage > 0 
        ? ((pricing.historicalAverage - pricing.currentPrice) / pricing.historicalAverage) * 100 
        : 0;
      
      const prompt = `You are a cruise pricing analyst. Detect anomalies in this pricing data.

Cruise: ${pricing.cruiseName} (${pricing.cruiseLine})
Cabin Tier: ${pricing.cabinTier}
Current Price: $${pricing.currentPrice}
Historical Average: $${pricing.historicalAverage}
Price Drop: ${priceDrop.toFixed(1)}%
Days Until Departure: ${pricing.daysUntilDeparture}
Recent Price History (last 30 days): ${pricing.priceHistory.slice(-10).join(', ')}

Provide JSON response:
{
  "anomalyType": "price_drop" | "price_spike" | "unusual_pattern" | "potential_error" | "strategic_pricing",
  "severity": "low" | "medium" | "high" | "critical",
  "confidence": number between 0 and 1,
  "description": "Detailed explanation of the anomaly",
  "recommendation": "Actionable recommendation for users/operators",
  "expectedPriceRange": { "min": number, "max": number }
}

Consider: seasonal patterns, days-to-departure pricing curves, competitor pricing, cabin tier norms, promotional calendars.`;

      try {
        const response = await this.nimClient.chatCompletion({
          messages: [
            { role: 'system', content: 'You are an expert cruise pricing analyst. Respond only with valid JSON.' },
            { role: 'user', content: prompt }
          ]
        });

        const content = response.choices[0]?.message?.content || '{}';
        const analysis = JSON.parse(content);
        results.push({ cruiseName: pricing.cruiseName, ...analysis });
        
        await new Promise(resolve => setTimeout(resolve, 100));
      } catch (error) {
        console.error(`[AnalyticsAgent] NIM price anomaly detection failed for ${pricing.cruiseName}:`, error);
        results.push({
          cruiseName: pricing.cruiseName,
          anomalyType: 'unusual_pattern',
          severity: 'low',
          confidence: 0,
          description: 'Analysis failed',
          recommendation: 'Manual review required',
          expectedPriceRange: { min: pricing.currentPrice * 0.8, max: pricing.currentPrice * 1.2 }
        });
      }
    }

    return results;
  }

  /**
   * Run full NIM-powered analysis pipeline
   * Orchestrates itinerary sentiment, review summarization, and price anomaly detection
   */
  async runFullNimAnalysis(data: {
    itineraries?: Array<{ cruiseName: string; itinerary: string; destination: string; duration: number }>;
    reviews?: Array<{ cruiseName: string; reviewText: string; rating?: number }>;
    pricing?: Array<{
      cruiseName: string;
      cruiseLine: string;
      cabinTier: string;
      currentPrice: number;
      historicalAverage: number;
      priceHistory: number[];
      daysUntilDeparture: number;
    }>;
  }): Promise<{
    itinerarySentiment?: Awaited<ReturnType<AnalyticsAgent['analyzeItinerarySentiment']>>;
    reviewSummaries?: Awaited<ReturnType<AnalyticsAgent['summarizeReviews']>>;
    priceAnomalies?: Awaited<ReturnType<AnalyticsAgent['detectPriceAnomalies']>>;
    summary: string;
  }> {
    if (!this.isNimEnabled()) {
      throw new Error('NIM is not enabled. Call enableNim() first.');
    }

    const results: any = {};
    
    if (data.itineraries && data.itineraries.length > 0) {
      console.log('[AnalyticsAgent] Running NIM itinerary sentiment analysis...');
      results.itinerarySentiment = await this.analyzeItinerarySentiment(data.itineraries);
    }
    
    if (data.reviews && data.reviews.length > 0) {
      console.log('[AnalyticsAgent] Running NIM review summarization...');
      results.reviewSummaries = await this.summarizeReviews(data.reviews);
    }
    
    if (data.pricing && data.pricing.length > 0) {
      console.log('[AnalyticsAgent] Running NIM price anomaly detection...');
      results.priceAnomalies = await this.detectPriceAnomalies(data.pricing);
    }

    // Generate executive summary using NIM
    if (this.nimClient) {
      const summaryPrompt = `Generate an executive summary for a cruise analytics report based on these analyses:

Itinerary Sentiment: ${results.itinerarySentiment ? JSON.stringify(results.itinerarySentiment.slice(0, 3)) : 'N/A'}
Review Summaries: ${results.reviewSummaries ? JSON.stringify(results.reviewSummaries.slice(0, 3)) : 'N/A'}
Price Anomalies: ${results.priceAnomalies ? JSON.stringify(results.priceAnomalies.slice(0, 5)) : 'N/A'}

Provide a concise executive summary (3-4 paragraphs) highlighting key findings, opportunities, and risks.`;

      try {
        const summaryResponse = await this.nimClient.chatCompletion({
          messages: [
            { role: 'system', content: 'You are a cruise industry executive analyst. Write a professional executive summary.' },
            { role: 'user', content: summaryPrompt }
          ]
        });
        results.summary = summaryResponse.choices[0]?.message?.content || 'Summary generation failed';
      } catch (error) {
        console.error('[AnalyticsAgent] NIM summary generation failed:', error);
        results.summary = 'Executive summary generation failed.';
      }
    }

    return results;
  }

  /**
   * Save the database schema to disk
   */
  saveSchema(): void {
    const schemaPath = path.join(this.outputDir, 'database_schema.sql');
    fs.writeFileSync(schemaPath, this.generateDatabaseSchema());
    console.log(`[AnalyticsAgent] Database schema saved: ${schemaPath}`);

    const alertPath = path.join(this.outputDir, 'alert_triggers.sql');
    fs.writeFileSync(alertPath, this.generateAlertTriggerFunction());
    console.log(`[AnalyticsAgent] Alert triggers saved: ${alertPath}`);
  }
}

/**
 * Create a pre-configured AnalyticsAgent
 */
export function createAnalyticsAgent(): AnalyticsAgent {
  return new AnalyticsAgent('./output/analytics');
}

export default AnalyticsAgent;
