{
  "name": "triptide-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node db/migrate.ts",
    "seed": "ts-node db/seed.ts",
    "seed:expanded": "ts-node db/seedExpanded.ts",
    "sync": "RUN_SYNC_ONLY=true ts-node index.ts",
    "sync:build": "RUN_SYNC_ONLY=true node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
