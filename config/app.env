# ============================================================================
# TripTide — Production Environment Configuration
# ============================================================================
# Managed by: DevOps / Platform Engineering
# Domain:     triptide.net
# Legal:      TripTide Network LLC
# ============================================================================

# --- Brand Identity ---
APP_NAME="TripTide"
APP_LEGAL_ENTITY="TripTide Network LLC"
APP_TAGLINE="Catch the deal before the tide rolls out."
PRIMARY_DOMAIN="triptide.net"

# --- Server ---
BIND_ADDRESS="127.0.0.1:3000"
NODE_ENV="production"
PORT=3000

# --- API Server ---
API_HOST="127.0.0.1"
API_PORT=3001
API_URL="http://${API_HOST}:${API_PORT}"

# --- Database ---
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="triptide"
DB_USER="triptide_app"
DB_PASSWORD="${TRIPTIDE_DB_PASSWORD}"

# --- Affiliate Tracking ---
AFFILIATE_SUBID_PREFIX="triptide_net_"
AFFILIATE_NETWORKS="ImpactRadius,CJAffiliate,Travelpayouts,CruiseDirect"
AFFILIATE_DEFAULT_NETWORK="Travelpayouts"

# --- Feature Flags ---
FEATURE_SOLO_FRIENDLY="true"
FEATURE_PRICE_ALERTS="true"
FEATURE_PRICE_HISTORY="true"
FEATURE_AFFILIATE_REDIRECT="true"
FEATURE_SSR_CACHE="true"

# --- Observability ---
LOG_LEVEL="info"
SENTRY_DSN="${TRIPTIDE_SENTRY_DSN}"
